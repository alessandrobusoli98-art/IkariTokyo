{
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [640, 750, 828, 1080, 1200, 1920],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2678400
  },
  "redirects": [
    { "source": "/product.html", "destination": "/product", "permanent": true }
  ],
  "rewrites": [
    { "source": "/product", "destination": "/api/product" }
  ]
}
